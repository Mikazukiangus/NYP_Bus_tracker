# LTA_ACCOUNT_KEY: API key for Singapore Land Transport Authority (LTA) DataMall.
# Used by /api/bus-arrival (v3 BusArrival) and /api/bus-route (BusRoutes, BusStops, BusServices).
# Obtain one from https://datamall.lta.gov.sg/
LTA_ACCOUNT_KEY="MY_LTA_ACCOUNT_KEY"

# DATA_GOV_SG_API_KEY (optional): data.gov.sg API key for /api/weather (NEA weather & air quality).
# Works without one, but keyless access is limited to 6 calls per 10 s, so a cold start takes a few
# requests to load all 12 datasets. Get a key from https://guide.data.gov.sg/developer-guide/api-overview
# DATA_GOV_SG_API_KEY=""

# PORT: Local dev server port (default 3000)
# PORT=3000
