# BusTrackerSG configuration — generated by npm run config:example.
# Copy to .env or .env.local. No real credentials belong in this file.
# Blank values use defaults. Only LTA_ACCOUNT_KEY is needed for live bus data.
# VITE_* is public and baked into the browser build. Never prefix a secret with VITE_.
# Restart dev after edits; rebuild/redeploy for public changes. Units and bounds are below.

# server
# Runtime mode; normally set by Node/Vite. Leave unset in .env.
# NODE_ENV="development"
# Local HTTP server port. Integer 1–65535.
PORT="3000"
# Local HTTP bind address or hostname.
HOST="0.0.0.0"
# Disable Vite hot reload and file watching.
DISABLE_HMR="false"
# Platform metadata, automatically set to 1 by Vercel; leave unset locally.
# VERCEL="false"

# security
# Public HTTPS origin for standalone-server redirects; no path, query or credentials. Vercel redirects HTTP at its edge.
APP_ORIGIN="https://nypbus-tracker.vercel.app"
# SERVER ONLY. Additional frontend origins allowed to read APIs, comma-separated; APP_ORIGIN is always allowed. Blank allows only APP_ORIGIN. No wildcards, paths, credentials, queries or fragments; HTTP loopback only in development.
CORS_ALLOWED_ORIGINS=""
# Standalone server: comma-separated trusted proxy IPs/CIDRs, loopback, or none. Only trust proxies that strip/overwrite forwarded headers.
TRUST_PROXY_CIDRS="loopback"

# outbound
# Server guarded fetch default total timeout, including response body; combines with caller cancellation. Milliseconds. Integer 1000–1500000.
OUTBOUND_TIMEOUT_MS="30000"
# Server guarded fetch connection timeout. Milliseconds. Integer 1000–120000.
OUTBOUND_CONNECT_TIMEOUT_MS="10000"

# outbound.retry
# Server live LTA read attempts including the first; health and NEA budgeted refreshes stay single-attempt. Integer 1–3.
OUTBOUND_READ_ATTEMPTS="2"
# Initial exponential retry ceiling, with equal jitter. Milliseconds. Integer 0–10000.
OUTBOUND_RETRY_BASE_MS="250"
# Maximum backoff/Retry-After wait. Longer provider delays skip immediate retry. Milliseconds. Integer 0–30000.
OUTBOUND_RETRY_MAX_MS="2000"

# lta
# SERVER SECRET. Required for live LTA data. Blank keeps the existing degraded/offline behaviour. Get a key at https://datamall.lta.gov.sg/.
LTA_ACCOUNT_KEY=""
# LTA API base; paths such as /v3/BusArrival are added by the app.
LTA_API_BASE_URL="https://datamall2.mytransport.sg/ltaodataservice"
# BusArrival and TrafficIncidents request timeout. Milliseconds. Integer 1000–120000.
LTA_REQUEST_TIMEOUT_MS="8000"
# Total timeout for one LTA route/stop dataset page, including retries, backoff and body reading. Milliseconds. Integer 1000–120000.
LTA_PAGE_TIMEOUT_MS="15000"
# Concurrent pages per dataset (three datasets load together). Integer 1–8.
LTA_PAGE_CONCURRENCY="8"
# Attempts for transient page errors. Integer 1–5.
LTA_PAGE_ATTEMPTS="3"
# Initial page retry ceiling, doubled after each retry with equal jitter. Milliseconds. Integer 0–10000.
LTA_PAGE_RETRY_DELAY_MS="500"
# Maximum page backoff/Retry-After wait within the total page timeout. Milliseconds. Integer 0–30000.
LTA_PAGE_RETRY_MAX_MS="10000"
# Warm-instance route dataset lifetime. Milliseconds. Integer 60000–604800000.
LTA_DATASET_TTL_MS="43200000"

# lta.cache
# CDN arrival freshness. Seconds. Integer 0–60.
LTA_ARRIVALS_CACHE_SECONDS="15"
# CDN arrival stale-while-revalidate. Seconds. Integer 0–120.
LTA_ARRIVALS_STALE_SECONDS="30"
# CDN route freshness. Seconds. Integer 0–604800.
LTA_ROUTES_CACHE_SECONDS="86400"
# CDN route stale-while-revalidate. Seconds. Integer 0–604800.
LTA_ROUTES_STALE_SECONDS="604800"
# CDN lifetime of unknown service responses. Seconds. Integer 0–604800.
LTA_NOT_FOUND_CACHE_SECONDS="3600"
# CDN incident freshness. Seconds. Integer 0–3600.
LTA_INCIDENTS_CACHE_SECONDS="120"
# CDN incident stale-while-revalidate. Seconds. Integer 0–3600.
LTA_INCIDENTS_STALE_SECONDS="300"

# health
# Five-digit LTA stop used by the health probe.
HEALTH_BUS_STOP_CODE="55329"
# Timeout for each upstream health probe. Milliseconds. Integer 1000–120000.
HEALTH_TIMEOUT_MS="5000"

# weather
# SERVER SECRET. Optional data.gov.sg API key. Blank uses keyless access.
DATA_GOV_SG_API_KEY=""
# Timeout for each NEA dataset request. Milliseconds. Integer 1000–120000.
NEA_REQUEST_TIMEOUT_MS="6000"
# Per-instance rate-limit window. Milliseconds. Integer 10000–60000.
NEA_RATE_WINDOW_MS="10500"
# Maximum keyless calls per window. Default leaves headroom. Integer 1–6.
NEA_KEYLESS_BUDGET="5"
# Maximum API-key calls per window. Default leaves headroom. Integer 1–12.
NEA_KEYED_BUDGET="10"
# Temperature/rainfall/humidity/lightning/wind cache lifetime. Milliseconds. Integer 60000–3600000.
NEA_OBSERVATION_TTL_MS="120000"
# PSI/PM2.5/UV/WBGT and 2-hour forecast cache lifetime. Milliseconds. Integer 60000–3600000.
NEA_SUMMARY_TTL_MS="600000"
# 24-hour forecast cache lifetime. Milliseconds. Integer 60000–86400000.
NEA_FORECAST_24H_TTL_MS="1800000"
# 4-day forecast cache lifetime. Milliseconds. Integer 60000–86400000.
NEA_OUTLOOK_TTL_MS="3600000"
# Complete weather snapshot CDN freshness. Seconds. Integer 0–3600.
NEA_CACHE_SECONDS="60"
# Complete weather snapshot stale-while-revalidate. Seconds. Integer 0–3600.
NEA_STALE_SECONDS="300"
# Incomplete weather snapshot CDN freshness. Seconds. Integer 0–60.
NEA_INCOMPLETE_CACHE_SECONDS="5"

# shapes
# Comma-separated Overpass endpoints, tried in order by npm run shapes.
OVERPASS_URLS="https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter"
# Rounds through the Overpass endpoint list. Integer 1–5.
OVERPASS_ROUNDS="3"
# Initial inter-round retry ceiling, doubled with equal jitter; capped at 300 seconds. Milliseconds. Integer 0–300000.
OVERPASS_RETRY_PAUSE_MS="60000"
# Overall rebuild request/retry deadline; stays inside the 30-minute workflow. Milliseconds. Integer 30000–1500000.
OVERPASS_DEADLINE_MS="1500000"
# Timeout for one Overpass HTTP request. Milliseconds. Integer 1000–1500000.
OVERPASS_REQUEST_TIMEOUT_MS="330000"
# Overpass query execution limit. Seconds. Integer 1–1200.
OVERPASS_QUERY_TIMEOUT_SECONDS="300"
# User-Agent identifying the route rebuild script.
OVERPASS_USER_AGENT="BusTrackerSG/1.0 (https://nypbus-tracker.vercel.app)"

# public

# public.retry
# PUBLIC. Static data and OneMap search attempts including the first; API polling/direct NEA/images do not add nested retries. Integer 1–3.
VITE_READ_ATTEMPTS="2"
# PUBLIC. Initial exponential retry ceiling with equal jitter. Milliseconds. Integer 0–10000.
VITE_RETRY_BASE_MS="250"
# PUBLIC. Maximum backoff/Retry-After wait within the existing request deadline. Milliseconds. Integer 0–30000.
VITE_RETRY_MAX_MS="2000"

# public.urls
# PUBLIC. Optional API origin/path prefix, e.g. https://api.example.com. Blank uses same-origin /api/*.
VITE_API_BASE_URL=""
# PUBLIC. Optional CDN prefix for /bus-routes/* and /route-shapes/*. Blank uses the site origin.
VITE_DATA_BASE_URL=""
# PUBLIC. NEA API base, shared by the server aggregator and keyless browser fallback.
VITE_NEA_API_BASE_URL="https://api-open.data.gov.sg/v2/real-time/api"
# PUBLIC. OneMap origin/prefix for search, map tiles and logo. Attribution remains canonical.
VITE_ONEMAP_BASE_URL="https://www.onemap.gov.sg"

# public.polling
# PUBLIC. Tracked-stop refresh interval. Seconds. Integer 5–300.
VITE_ARRIVALS_REFRESH_SECONDS="15"
# PUBLIC. Trip and saved-stop refresh interval. Seconds. Integer 5–300.
VITE_MULTI_STOP_REFRESH_SECONDS="30"
# PUBLIC. Traffic incident refresh interval. Seconds. Integer 30–3600.
VITE_INCIDENTS_REFRESH_SECONDS="180"
# PUBLIC. Weather refresh interval. Seconds. Integer 30–3600.
VITE_WEATHER_REFRESH_SECONDS="300"
# PUBLIC. Delay to fill incomplete weather snapshots. Milliseconds. Integer 10000–120000.
VITE_WEATHER_RETRY_MS="12000"
# PUBLIC. Retries to fill an incomplete weather snapshot. Integer 0–10.
VITE_WEATHER_RETRY_ATTEMPTS="3"

# public.cache
# PUBLIC. Browser route/shape success-cache lifetime; 0 shares pending requests only. Seconds. Integer 0–3600.
VITE_ROUTE_ASSETS_CACHE_SECONDS="300"

# public.timeouts
# PUBLIC. Arrival request timeout. Milliseconds. Integer 1000–120000.
VITE_ARRIVALS_TIMEOUT_MS="5000"
# PUBLIC. Static route/shape, weather and incident timeout. Milliseconds. Integer 1000–120000.
VITE_REQUEST_TIMEOUT_MS="10000"
# PUBLIC. Cold /api/bus-route timeout. Milliseconds. Integer 1000–120000.
VITE_ROUTE_TIMEOUT_MS="30000"
# PUBLIC. Bus network download timeout. Milliseconds. Integer 1000–120000.
VITE_NETWORK_TIMEOUT_MS="20000"
# PUBLIC. OneMap and direct NEA fallback timeout. Milliseconds. Integer 1000–120000.
VITE_EXTERNAL_TIMEOUT_MS="8000"
# PUBLIC. OneMap tile and attribution logo image timeout. Milliseconds. Integer 1000–120000.
VITE_MAP_IMAGE_TIMEOUT_MS="15000"
# PUBLIC. Explicit GPS fix timeout. Milliseconds. Integer 1000–120000.
VITE_GPS_TIMEOUT_MS="8000"
# PUBLIC. Startup GPS fix timeout. Milliseconds. Integer 1000–120000.
VITE_STARTUP_GPS_TIMEOUT_MS="5000"
# PUBLIC. Get-off alarm GPS watch timeout. Milliseconds. Integer 1000–120000.
VITE_ALARM_GPS_TIMEOUT_MS="20000"

# CI-only secret, used by .github/workflows/refresh-data.yml, not by the app:
# VERCEL_DEPLOY_HOOK_URL=""  # Set in GitHub Actions secrets; do not expose in the browser.
