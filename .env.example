# LTA_ACCOUNT_KEY: API key for Singapore Land Transport Authority (LTA) DataMall.
# Used by /api/bus-arrival (v3 BusArrival) and /api/bus-route (BusRoutes, BusStops, BusServices).
# Obtain one from https://datamall.lta.gov.sg/
LTA_ACCOUNT_KEY="MY_LTA_ACCOUNT_KEY"

# PORT: Local dev server port (default 3000)
# PORT=3000
